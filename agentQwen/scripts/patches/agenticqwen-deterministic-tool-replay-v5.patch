+def _normal_path_completed(tool_return_expected, history_messages):
+    expected = _load_expected(tool_return_expected)
+    normal_path = (expected or {}).get("normal_path", []) or []
+    if not normal_path:
+        return False
+    try:
+        calls = [json.loads(item) for item in re.findall(r"<tool_call>(.*?)</tool_call>", history_messages, re.DOTALL)]
+        responses = [json.loads(item) for item in re.findall(r"<tool_response>(.*?)</tool_response>", history_messages, re.DOTALL)]
+    except Exception:
+        return False
+    pairs = list(zip(calls, responses))
+    return all(
+        any(
+            call.get("name") == step.get("tool_name")
+            and call.get("arguments") == step.get("input")
+            and response == step.get("expected_output")
+            for call, response in pairs
+        )
+        for step in normal_path
+    )
