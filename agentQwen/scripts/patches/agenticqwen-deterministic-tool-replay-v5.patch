+def _fixture_response(tool_return_expected, mock_tool_name_and_args):
+    expected = _load_expected(tool_return_expected)
+    for path_name in ("normal_path", "hack_path"):
+        for step in (expected or {}).get(path_name, []) or []:
+            if step.get("tool_name") == mock_tool_name_and_args.get("name") and step.get("input") == mock_tool_name_and_args.get("arguments"):
